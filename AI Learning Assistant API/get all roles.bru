meta {
  name: get all roles
  type: http
  seq: 12
}

get {
  url: http://127.0.0.1:8000/roles/all?page=1&page_size=5&sort=asc
  body: none
  auth: bearer
}

params:query {
  page: 1
  page_size: 5
  sort: asc
}

auth:bearer {
  token: {{access_token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
