meta {
  name: change password
  type: http
  seq: 10
}

patch {
  url: http://127.0.0.1:8000/users/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "old_password": "user 1",
    "new_password": "new123456"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
